{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glx Calculator",
  "version": "0.1.0",
  "identifier": "com.glx.calculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glx Calculator",
        "width": 440,
        "height": 820,
        "minWidth": 380,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Glx",
    "copyright": "Copyright © 2026 Glx",
    "category": "Utility",
    "shortDescription": "Keyboard-first desktop calculator with scientific, programmer, statistics, converter, date and worksheet modes.",
    "longDescription": "Glx Calculator is a soft-UI, keyboard-first calculator for Windows. It includes standard, scientific, programmer and statistics modes, unit and currency conversion, date arithmetic and mortgage, fuel and lease worksheets, with history, light/dark themes and Chinese/English UI.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
