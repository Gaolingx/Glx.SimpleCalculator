{
  "name": "glx-calculator",
  "private": true,
  "version": "0.1.0",
  "description": "Glx Calculator desktop app (Tauri 2 + React 19)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "i18next": "^27.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
